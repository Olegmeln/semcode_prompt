{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semcode.local/schemas/semantic-ir-0.2.json",
  "title": "SemCode Semantic IR v0.2",
  "type": "object",
  "required": [
    "ir_version",
    "request_id",
    "raw_input",
    "normalized_code",
    "intent",
    "sources",
    "constraints",
    "output",
    "interpretation"
  ],
  "properties": {
    "ir_version": {
      "const": "0.2"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "raw_input": {
      "type": "string"
    },
    "normalized_code": {
      "type": "string"
    },
    "domain": {
      "type": [
        "string",
        "null"
      ]
    },
    "intent": {
      "type": "object",
      "required": [
        "action",
        "object"
      ],
      "properties": {
        "action": {
          "type": "string"
        },
        "object": {
          "type": "string"
        },
        "intensity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        }
      },
      "additionalProperties": true
    },
    "target": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "environment": {
          "type": [
            "string",
            "null"
          ]
        },
        "adapter": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "reference": {
            "type": [
              "string",
              "null"
            ]
          },
          "cardinality": {
            "enum": [
              "one",
              "multiple",
              "unknown"
            ]
          },
          "priority": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": true
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": true
    },
    "constraints": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "memory": {
      "type": "object",
      "properties": {
        "read": {
          "type": "boolean"
        },
        "write": {
          "type": "boolean"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "compiled_prompt",
            "json",
            "prompt_and_json",
            "codec",
            "api_payload",
            "artifact",
            "direct_result"
          ]
        },
        "format": {
          "type": [
            "string",
            "null"
          ]
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "interpretation": {
      "type": "object",
      "required": [
        "overall_confidence",
        "level",
        "assumptions",
        "critical_ambiguities"
      ],
      "properties": {
        "overall_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "level": {
          "enum": [
            "H",
            "M",
            "L"
          ]
        },
        "field_confidence": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "critical_ambiguities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "question": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "origin"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "value": {},
          "origin": {
            "enum": [
              "explicit_user_input",
              "personal_language_memory",
              "project_memory",
              "current_document",
              "reasonable_default",
              "target_adapter"
            ]
          },
          "evidence": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
